{
  "name": "uhliky-vaelu",
  "productName": "Uhliky Vaelu",
  "private": true,
  "version": "0.1.4",
  "description": "Popelavá louka — Dark Fantasy ASCII RPG",
  "author": "Popelava Louka Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.ashenascii.popelavalouka",
    "productName": "Uhliky Vaelu",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Uhliky-Vaelu-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
